{
  "name": "sidepad",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "electron-rebuild -f -w better-sqlite3",
    "test:e2e": "playwright test",
    "test:e2e:regression": "playwright test tests/e2e/regression",
    "posttest:e2e": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "package": "npm run build && electron-packager . sidepad --out=release --overwrite --asar.unpackDir=resources/mcp-servers --ignore=\"^/(release|dist-app|tests|docs|playwright-report|test-results|coverage|\\.github|\\.worktrees|\\.claude|jira|inbox|outbox|confluence|deployments|configs)$\"",
    "package:mac-arm": "npm run package -- --platform=darwin --arch=arm64",
    "package:mac-x64": "npm run package -- --platform=darwin --arch=x64",
    "package:win": "npm run package -- --platform=win32 --arch=x64",
    "package:linux": "npm run package -- --platform=linux --arch=x64",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@trpc/client": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "better-sqlite3": "^12.9.0",
    "electron": "^41.3.0",
    "electron-trpc": "^0.7.1",
    "gray-matter": "^4.0.3",
    "i18next": "^26.0.7",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsdom": "^29.0.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "ollama": "^0.6.3",
    "openai": "^6.34.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.1.0",
    "playwright": "^1.59.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.4",
    "tesseract.js": "^5.1.1",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^22.19.17",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "electron-vite": "^5.0.0",
    "eslint": "^10.2.1",
    "postcss": "^8.4.38",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  }
}
